# Server
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
FLASK_SECRET_KEY=smart-system-doctor-local

# Paths
# DATABASE_PATH=system_logs.db
# LOG_DIR=logs
# REPORT_DIR=reports

# Monitoring intervals (seconds)
DISK_NETWORK_INTERVAL=5
HISTORY_INTERVAL=10
SECURITY_SCAN_INTERVAL=15
PORT_SCAN_INTERVAL=30
PRUNE_INTERVAL=3600

# Database retention
HISTORY_RETENTION_DAYS=14
MAX_HISTORY_POINTS=200
DOWNLOAD_POINTS=120

# Security analysis weights
WEIGHT_SUSPICIOUS_FILENAME=15
WEIGHT_SUSPICIOUS_PATH=20
WEIGHT_NETWORK_ACTIVITY=20
WEIGHT_HIGH_CPU=10
WEIGHT_HIGH_MEMORY=10
WEIGHT_UNUSUAL_PARENT=15
WEIGHT_PRIVILEGED_ANOMALY=10
SUSPICIOUS_CPU_PERCENT=70.0
SUSPICIOUS_MEMORY_PERCENT=50.0
NETWORK_FLAG_CUTOFF=15
HEURISTIC_STRENGTH_CEILING=0.9

# Health scoring (gradual penalties)
HEALTH_CPU_LOW=60
HEALTH_CPU_MAX_PENALTY=40
HEALTH_CPU_SCALE=1.0
HEALTH_RAM_LOW=60
HEALTH_RAM_MAX_PENALTY=40
HEALTH_RAM_SCALE=1.0
HEALTH_DISK_LOW=70
HEALTH_DISK_MAX_PENALTY=30
HEALTH_DISK_SCALE=1.0
HEALTH_PROCESS_THRESHOLD=500
HEALTH_PROCESS_MAX_PENALTY=10
HEALTH_PROCESS_SCALE=0.1

# Predictions
PREDICTION_HORIZON_POINTS=5
PREDICTION_MIN_SAMPLES=8

# Process protection
# PROTECTED_PROCESS_NAMES=system,systemd,kernel_task,launchd,svchost,...
# ALLOW_FORCE_PROTECTED=false
TERMINATE_TIMEOUT=3
